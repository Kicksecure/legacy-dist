apt_mark_deprecated_packages_for_autoremoval_three() {
   if [ -f "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1" ]; then
      return 0
   fi

   apt-mark manual pulseaudio-qubes &>/dev/null || true
   apt-mark manual pulseaudio-utils &>/dev/null || true
   apt-mark manual pulseaudio &>/dev/null || true

   mkdir --parents "/var/lib/whonix/do_once"
   touch "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1"
}

apt_mark_deprecated_packages_for_autoremoval_four() {
   if [ -f "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1" ]; then
      return 0
   fi

   apt-mark manual qubes-core-agent-passwordless-root &>/dev/null || true

   mkdir --parents "/var/lib/whonix/do_once"
   touch "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1"
}

apt_mark_deprecated_packages_for_autoremoval_five() {
   if [ -f "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1" ]; then
      return 0
   fi

   ## See:
   ## package dist-base-files
   ## file /etc/dracut.conf.d/60-dist-base-files.conf
   apt-mark auto dracut-config-generic &>/dev/null || true

   mkdir --parents "/var/lib/whonix/do_once"
   touch "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1"
}

apt_mark_deprecated_packages_for_autoremoval_six() {
   if [ -f "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1" ]; then
      return 0
   fi

   ## Semi-redundant with htop, buggy. See:
   ## https://github.com/lxqt/qps/issues/528
   apt-mark auto qps &>/dev/null || true

   mkdir --parents "/var/lib/whonix/do_once"
   touch "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_1"
}

apt_mark_keep_one() {
   if [ -f "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_2" ]; then
      return 0
   fi

   ## 'apt-mark manual' - keep
   ## 'apt-mark auto'   - mark as automatically installed for 'apt autoremove'

   ## * In the past, a meta packages has 'Depends:' on these packages.
   ## * Nowadays, these are "weak recommended packages". No meta package
   ##   'Depends:' on these packages. These packages are conditionally
   ##   installed by build steps **_install-packages' and '*_create-lb-iso'.
   apt-mark manual kicksecure-network-conf &>/dev/null || true
   apt-mark manual kicksecure-network-conf-gui &>/dev/null || true
   apt-mark manual tirdad &>/dev/null || true
   apt-mark manual tirdad-dkms &>/dev/null || true
   apt-mark manual firmware-nonfreedom-network &>/dev/null || true

   mkdir --parents "/var/lib/whonix/do_once"
   touch "/var/lib/whonix/do_once/${FUNCNAME[0]}_version_2"
}

migrations_for_old_versions() {
   apt_mark_deprecated_packages_for_autoremoval
   apt_mark_deprecated_packages_for_autoremoval_two
   symlink_fix
   #apt_mark_virtualbox_guest_addition_from_debian_package_autoremoval
   apt_mark_deprecated_packages_for_autoremoval_three
   apt_mark_deprecated_packages_for_autoremoval_four
   apt_mark_deprecated_packages_for_autoremoval_five
   apt_mark_deprecated_packages_for_autoremoval_six
   apt_mark_keep_one
}

## dpkg exports DPKG_MAINTSCRIPT_* into every maintainer script; nothing in
## this file assigns them, which is what SC2154 reports.
# shellcheck disable=SC2154
true "1: $1"
true "2: $2"

true "INFO: Configuring ${DPKG_MAINTSCRIPT_PACKAGE}..."

get_build_version

my_old_package_version="$2"
## example my_old_package_version:
## 3:9.9-1

## Will probably "forever" be required.
nonfree_firmware_preseed
keyboard_configuration_debconf_preseed
kexec_tools_preseed

if [ "$1" = "install" ]; then
   true "INFO: ${DPKG_MAINTSCRIPT_PACKAGE} not installed yet."
else
   true "INFO: ${DPKG_MAINTSCRIPT_PACKAGE} already installed."
   migrations_for_old_versions
fi

true "INFO: End configuring ${DPKG_MAINTSCRIPT_PACKAGE}."

true "INFO: debhelper beginning here."

#DEBHELPER#

true "INFO: Done with debhelper."

true "
#####################################################################
## INFO: END  : ${DPKG_MAINTSCRIPT_PACKAGE} ${DPKG_MAINTSCRIPT_NAME} $*
#####################################################################
"

## Explicitly "exit 0", so eventually trapped errors can be ignored.
exit 0
